# ─── Sistema operativo ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Entorno virtual Python ────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Dependencias locales ──────────────────────────────────
node_modules/

# ─── Archivos privados / no versionables ───────────────────
# Carpeta .ignore donde el usuario guarda CSVs, Excels y PDFs de origen
.ignore/
ignoreArchives/

# Extractos temporales
pdf_extract.txt

# Archivos intermedios de datos (Excel/CSV crudos)
*.xlsx
*.csv

# ─── Caché de Python ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ─── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Editores / IDEs ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Archivos de distribución / build ──────────────────────
dist/
build/
*.zip
*.tar.gz

# ─── Archivos sensibles (nunca subir) ──────────────────────
.env
.env.local
.env.*.local
*.key
*.pem

# ─── Archivos temporales del sistema ───────────────────────
*.tmp
*.temp
*.bak

# ─── Agente/herramientas autónomas (metadata de runs, puede tener paths y logs sensibles) ─
.cave/

# ─── Basura de macOS que vino en un zip ────────────────────
**/__MACOSX/
._*

# ─── Fuente vectorial fuente (Illustrator), no se usa en producción ─
*.ai

# ─── Video pesado — no pertenece en git ────────────────────
*.mp4

# ─── Cache de Netlify CLI/build ────────────────────────────
.netlify/

