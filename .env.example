# ── Supabase (Frontend + Serverless Functions)
SUPABASE_URL=tu_supabase_url_aqui
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# ── Supabase Service Role / Secret key (SOLO Serverless Functions y scripts locales — NUNCA al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_secret_key_aqui

# ── Google Business Profile API (ingesta oficial de reseñas)
# Genera el refresh token con: node scripts/gbp-auth.js  (si la pantalla de consentimiento está en "Testing", caduca a los 7 días)
GBP_CLIENT_ID=tu_oauth_client_id_aqui
GBP_CLIENT_SECRET=tu_oauth_client_secret_aqui
GBP_REFRESH_TOKEN=tu_refresh_token_aqui
GBP_ACCOUNT_ID=accounts/tu_numero_de_cuenta
# Protege /.netlify/functions/gbp-sync (Authorization: Bearer <secreto>). Genera uno largo y aleatorio.
GBP_SYNC_SECRET=tu_secreto_para_el_sync_aqui

# ── Netlify (solo para despliegues/CLI desde esta máquina)
NETLIFY_AUTH_TOKEN=tu_netlify_personal_access_token
NETLIFY_SITE_ID=tu_site_id

# ── Diagnóstico y clasificación
DIAG_SECRET=tu_secreto_para_diagnostico_aqui
GEMINI_API_KEY=opcional_si_no_usas_USE_LOCAL_NLP
USE_LOCAL_NLP=true
